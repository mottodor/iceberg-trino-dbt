# Local-only training credentials. Copy this file to .env before running the project.
RUSTFS_ACCESS_KEY=training-access-key
RUSTFS_SECRET_KEY=training-secret-key-change-me
POLARIS_CLIENT_ID=training-client
POLARIS_CLIENT_SECRET=training-client-secret-change-me

# Prefix for isolated dbt schemas: <prefix>_fixtures/bronze/silver/gold.
DBT_TRINO_SCHEMA=learn
